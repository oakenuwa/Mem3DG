% Singles and couples diffusing ON the Mem3DG membrane, nucleating filaments
%
% This is the dynamic counterpart of config.cym: instead of a static placement
% check, the surface objects diffuse and seed new filaments where they sit, so
% every filament is born AT the membrane rather than in the lumen.
%
% `nucleate_in_plane = 1' makes the new filament tangent to the surface: the
% nucleator asks the Space for normalToEdge(pos) and projects the random
% direction onto the tangent plane.  SpaceMem3DG implements that from the
% angle-weighted pseudonormal, so it works on the membrane exactly as it does
% on a built-in sphere.

set simul system
{
    time_step  = 0.000025
    viscosity  = 0.05
}

set space membrane
{
    shape = mem3dg
}
new space membrane

% ---- the filament that gets nucleated (must precede `seeder': the hand's
% ---- `nucleate' key is resolved to a fiber class at parse time) --------------------------------------
set fiber actin
{
    rigidity     = 0.5
    segmentation = 0.1
    steric       = 1, 0.01
    confine      = inside, 100, membrane

    activity        = grow
    growing_speed   = 4.0
    growing_force   = 1.7
    shrinking_speed = 0
}

% ---- hands -----------------------------------------------------------------
set hand binder
{
    binding_rate   = 10
    binding_range  = 0.05
    unbinding_rate = 0.1
}

set hand seeder
{
    binding_rate   = 10
    binding_range  = 0.05
    unbinding_rate = 0.1

    activity = nucleate
    % rate, fiber type, spec for the new fiber
    nucleate = 5, actin, (length=0.1; plus_end=grow;)
    % orient the new filament tangent to the membrane at the nucleation point
    nucleate_in_plane = 1
}

% ---- surface objects: these diffuse on the membrane and nucleate ------------
set single surfaceNucleator
{
    hand      = seeder
    activity  = diffuse
    diffusion = 0.05
    confine   = on, 0, membrane
}

set couple surfaceNucleatorPair
{
    hand1     = seeder
    hand2     = binder
    stiffness = 100
    diffusion = 0.05
    confine   = on, 0, membrane
}

% ---- plain surface/inside objects, for comparison in the render ------------
set single surfaceDiffuser
{
    hand      = binder
    activity  = diffuse
    diffusion = 0.05
    confine   = on, 0, membrane
}

set couple innerCross
{
    hand1     = binder
    hand2     = binder
    stiffness = 100
    diffusion = 0.05
    confine   = inside, 0, membrane
}

new  60 single surfaceNucleator     { position = surface 0.01 }
new  40 couple surfaceNucleatorPair { position = surface 0.01 }
new 100 single surfaceDiffuser      { position = surface 0.01 }
new  50 couple innerCross           { position = inside }
