% Singles and couples placed ON / INSIDE a Mem3DG membrane
%
% `shape = mem3dg' exposes the membrane the driver owns through Cytosim's
% Space interface, so the ordinary placement and confinement keywords work.
%
% Cytosim's base Space derives everything from three primitives, all of which
% SpaceMem3DG forwards to libmem3dg:
%     place()        -> boundaries() + inside()      "position = inside"
%     placeOnEdge(R) -> boundaries() + project()     "position = surface R"
%     bounce()       -> project()    + inside()      "confine = inside"
%
% NOTE singles/couples accept only off | on/surface | inside.  Cytosim has no
% `outside' key for them (only fibers do) -- see single_prop.cc.

set simul system
{
    time_step  = 0.000025
    viscosity  = 0.05
}

set space membrane
{
    shape = mem3dg
}
new space membrane

% ---- hands -----------------------------------------------------------------
set hand binder
{
    binding_rate  = 10
    binding_range = 0.05
    unbinding_rate = 0.1
}

% ---- singles: some pinned ON the surface, some free INSIDE -----------------
set single surfaceAnchor
{
    hand    = binder
    % `fixed' singles are pinned where they are created, so Cytosim rejects a
    % `confine' on them -- `position = surface' below is what puts them on the
    % membrane
    activity = fixed
}

set single surfaceDiffuser
{
    hand    = binder
    activity = diffuse
    diffusion = 0.05
    confine = on, 0, membrane
}

set single innerDiffuser
{
    hand    = binder
    activity = diffuse
    diffusion = 0.05
    confine = inside, 0, membrane
}

% ---- couples: confined to the surface --------------------------------------
set couple surfaceCross
{
    hand1 = binder
    hand2 = binder
    stiffness = 100
    diffusion = 0.05
    confine = on, 0, membrane
}

set couple innerCross
{
    hand1 = binder
    hand2 = binder
    stiffness = 100
    diffusion = 0.05
    confine = inside, 0, membrane
}

new 200 single surfaceAnchor   { position = surface 0.01 }
new 100 single surfaceDiffuser { position = surface 0.01 }
new 100 single innerDiffuser { position = inside }
new 150 couple surfaceCross  { position = surface 0.01 }
new  50 couple innerCross    { position = inside }
