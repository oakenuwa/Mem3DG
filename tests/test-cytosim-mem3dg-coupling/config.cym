% Coupled Cytosim + Mem3DG test simulation
%
% Geometry is matched to tests/frame9.ply, which is an open membrane cap
% spanning x,y in [-0.78, 0.68] and z in [0, 0.71].  Filaments are placed
% inside that same region so they genuinely contact the membrane -- earlier
% smoke tests used actin.cym, whose filaments sit near +-0.13 and never
% touched the membrane at a physical cutoff.
%
% NOTE the driver parses this with Run=0: the `run' command is deliberately
% absent, because coupled_driver owns the time loop.

set simul system
{
    time_step  = 0.0001
    viscosity  = 0.05
}

set space cell
{
    shape = sphere
}

new space cell
{
    radius = 1.0
}

set fiber actin
{
    rigidity     = 0.05
    segmentation = 0.1
    steric       = 1, 0.01
    confine      = inside, 100, cell
}

% filaments spread through the membrane's own bounding region
new 12 fiber actin
{
    length = 0.4
}
